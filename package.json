{
  "name": "lexicue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter web build",
    "dev": "tsx packages/dev-api/src/dev.ts",
    "dev:mock": "pnpm --filter web dev:mock",
    "dev:api": "tsx packages/dev-api/src/bin.ts",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && pnpm --filter web typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "harness": "tsx packages/cli/src/bin.ts",
    "evals": "tsx evals/src/bin.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.9.2",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.9.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
