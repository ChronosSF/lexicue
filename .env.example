# Copy this file to .env and paste the key after the equals sign. The copy is
# git-ignored. Only the command-line tool, the eval runner and the local
# development API read it, and a value here wins over the shell, so this
# checkout always uses its own key.
ANTHROPIC_API_KEY=

# Stripe, in test mode only (specification section 6.6). Both are optional and
# both are currently unset, which is why nothing in this repository has ever
# talked to Stripe: with them absent, POST /api/billing/webhook refuses and
# says which to set, and a top-up uses the local checkout screen instead of
# Stripe's hosted page. The root README has the three commands to run once
# these are filled in.
#
# Use test-mode values (sk_test_… and whsec_…) and nothing else. Nothing in
# this repository should ever see a live key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
