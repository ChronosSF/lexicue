{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:serve": "vite build --mode mock --outDir dist-e2e && vite preview --outDir dist-e2e --host 127.0.0.1 --port 4183 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@lexicue/harness": "workspace:*",
    "@lexicue/pricing": "workspace:*",
    "@lexicue/shared": "workspace:*",
    "@lexicue/subtitles": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "vite": "8.3.0"
  }
}
